# Copy to .env.local (local) and add the same keys in Vercel → Settings → Environment Variables.

# Neon Postgres (pooled connection string). Use "pglite" for an in-memory test DB.
DATABASE_URL=

# Gemini — post-call classification. gemini-2.5-flash is closed to new keys.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# USD per 1M tokens (check ai.google.dev/pricing for your model)
GEMINI_PRICE_IN_PER_M=0.30
GEMINI_PRICE_OUT_PER_M=2.50

# Resend — designer handoff + escalation email.
# Until a domain is verified: FROM must be onboarding@resend.dev and TO must be the Resend account owner's email.
RESEND_API_KEY=
EMAIL_FROM=Aangan Studio <onboarding@resend.dev>
HANDOFF_EMAIL=
ESCALATION_EMAIL=

# Cal.com (optional — without it, slots are offered from 11am/4pm defaults and the front desk confirms)
CALCOM_API_KEY=
CALCOM_USERNAME=
CALCOM_EVENT_SLUG=consultation
BOOKING_FALLBACK_EMAIL=

# HubSpot private app token (optional) — scopes: crm.objects.contacts.read/write, crm.objects.deals.write
HUBSPOT_TOKEN=

# Vaani Voice API key (Settings → API Keys) — used to look up the caller's number + call cost
VAANI_API_KEY=

# Shared secret Vaani sends in header x-aangan-secret (tools + webhook)
WEBHOOK_SECRET=
# Dashboard password (any username)
DASHBOARD_PASSWORD=

# Cost model
VAANI_COST_PER_MIN_INR=6
FIXED_MONTHLY_COST_INR=0
USD_INR=88
